NEXT_PUBLIC_APP_NAME=PayVerify
NEXT_PUBLIC_APP_ENV=demo
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Bogota
NEXT_PUBLIC_DEMO_MODE=true

# Supabase public client settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_OAUTH_STATE_SECRET=
EMAIL_TOKEN_ENCRYPTION_KEY=

# Google OAuth - Gmail readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/email/google/callback

# Microsoft Entra OAuth - Graph delegated Mail.Read
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/email/microsoft/callback
